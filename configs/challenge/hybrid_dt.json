{
    "model_params": {
        "model_name": "challenge",
        "model_type": "tr_enc",
        "time_lag": 24,
        "train_ahead": 8,
        "num_layers": 4,
        "nhead": 4,
        "d_model": 128,
        "ff_dim": 384,
        "lr": 0.0005,
        "lr_factor": 0.5,
